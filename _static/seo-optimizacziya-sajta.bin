<!-- /Yandex.Metrika и VK цели под Utm метки в метке utm_retarget -->
<script>
document.addEventListener("DOMContentLoaded", function () {
  var timeout = 15000; // 15 секунд

  var params = new URLSearchParams(window.location.search);
  var utmRetarget = params.get('utm_retarget');

  console.log('[utm_retarget]', utmRetarget); // <-- сразу видно, что из URL вытащили

  if (!utmRetarget) {
    console.log('[utm_retarget] параметр не найден, цели не шлём');
    return;
  }

  setTimeout(function () {
    console.log('[utm_retarget] 15 секунд прошло, шлём цели для:', utmRetarget);

    // Яндекс.Метрика
    if (typeof ym !== "undefined") {
      ym(33578164, "reachGoal", utmRetarget);
      console.log('[utm_retarget] отправили в Метрику reachGoal:', utmRetarget);
    } else {
      console.log('[utm_retarget] ym не определён, цель в Метрику не ушла');
    }

    // VK Реклама (через Top.Mail.Ru ретаргетинг)
    if (typeof _tmr !== "undefined") {
      _tmr.push({
        type: 'reachGoal',
        id: 3719503,
        goal: utmRetarget
      });
      console.log('[utm_retarget] отправили в _tmr goal:', utmRetarget);
    } else {
      console.log('[utm_retarget] _tmr не определён, цель в VK/TopMail не ушла');
    }

  }, timeout);
});
</script>





